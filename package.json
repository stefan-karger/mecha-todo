{
  "name": "mecha-todo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:playwright": "vite build --config vite.playwright.config.ts",
    "preview": "vite preview",
    "preview:playwright": "vite preview --config vite.playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:domain": "playwright test tests/domain",
    "test:smoke": "playwright test tests/e2e/shell.spec.ts --project=desktop-chrome",
    "release:check": "playwright test && node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@solidjs/web": "2.0.0-rc.8",
    "idb": "8.0.3",
    "solid-js": "2.0.0-rc.8",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@solidjs/vite-plugin": "3.0.0-next.43",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
